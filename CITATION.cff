    given-names: Ka-Kyung
    affiliation: "Independent Researcher, Seoul, Republic of Korea"
    email: kakyung.kim@gmail.com
repository-code: "https://github.com/kakyungkim/VeriVar"
license: MIT
keywords:
  - somatic variant interpretation
  - large language models
  - retrieval-augmented generation
  - citation faithfulness
  - precision oncology
  - bioinformatics
version: 1.0.0
