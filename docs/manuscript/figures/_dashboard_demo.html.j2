<!DOCTYPE html>
<!-- VeriVar: representative dashboard view for Supplementary Figure S3.
     GENERATED by make_dashboard_demo.py from this Jinja2 template. Do not hand-edit
     _dashboard_demo.html; edit this template or the generator instead.
     Every call, code, point total, rationale, citation and count is filled from
     data/outputs/cohort_interpretation.json, the SOP-strict VICC engine
     (src/classify/vicc_rules.py via src/dashboard/vicc_arm.py) and the cached
     grounded-chat answers in _dashboard_demo_chat.json. -->
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  :root{
    --green:#009E73; --blue:#0072B2; --purple:#CC79A7; --verm:#D55E00;
    --ink:#1f2933; --muted:#5f6c7b; --line:#e3e8ee; --bg:#ffffff; --panel:#f7f9fc;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);
    font-family:Helvetica,Arial,"Helvetica Neue",sans-serif;color:var(--ink);}
  .app{width:1160px;margin:0 auto;padding:26px 30px 34px;}
  h1{font-size:26px;margin:0 0 2px;font-weight:700;display:flex;align-items:center;gap:10px;}
  h1 svg{width:34px;height:34px;display:block;}
  .wordmark{font-weight:800;letter-spacing:-.01em;}
  .wordmark .veri{color:#1B2E5E;} .wordmark .var{color:#2EB8A6;}
  .sub{color:var(--muted);font-size:13px;margin-bottom:16px;}
  .tabs{display:flex;gap:26px;border-bottom:1px solid var(--line);margin-bottom:20px;}
  .tab{padding:8px 2px;font-size:14px;color:var(--muted);}
  .tab.active{color:var(--ink);font-weight:700;border-bottom:2.5px solid var(--blue);}
  .vhead{display:flex;align-items:baseline;gap:14px;margin:6px 0 2px;}
  .vhead .name{font-size:20px;font-weight:700;}
  .vhead .ctx{font-size:15px;color:var(--muted);}
  .badges{font-size:12px;color:var(--muted);margin-bottom:14px;}
  .badge{display:inline-block;background:var(--panel);border:1px solid var(--line);
    border-radius:11px;padding:2px 9px;margin-right:6px;}
  .cols{display:flex;gap:18px;}
  .card{flex:1;background:var(--panel);border:1px solid var(--line);border-radius:10px;
    padding:14px 16px;}
  .card .mhdr{font-size:12px;letter-spacing:.04em;text-transform:uppercase;
    font-weight:700;margin-bottom:8px;}
  .mhdr.gen{color:var(--blue);} .mhdr.det{color:var(--purple);}
  .pill{display:inline-block;border-radius:11px;padding:2px 10px;font-size:12.5px;
    font-weight:700;color:#fff;}
  .pill.onc{background:var(--green);} .pill.vus{background:#8a94a6;}
  .tier{font-size:13px;color:var(--ink);font-weight:600;margin-left:8px;}
  .rat{font-size:13px;line-height:1.5;margin-top:9px;color:#2a333d;}
  .cites{font-size:12px;margin-top:8px;color:var(--muted);}
  a{color:var(--blue);text-decoration:none;border-bottom:1px solid rgba(0,114,178,.35);}
  .sect{margin-top:18px;border:1px solid var(--line);border-radius:10px;overflow:hidden;}
  .sect .bar{background:#eef3f9;padding:9px 14px;font-size:13px;font-weight:600;}
  .sect .body{padding:12px 16px;}
  .ev{font-size:12.5px;line-height:1.5;margin-bottom:6px;}
  .ev .dis{color:var(--muted);}
  .ext{font-size:12px;margin-top:8px;color:var(--muted);}
  .chat{margin-top:16px;}
  .chat .q{font-size:14px;font-weight:700;margin-bottom:10px;}
  .bubble{border-radius:12px;padding:10px 14px;font-size:13px;line-height:1.5;
    max-width:88%;margin-bottom:10px;}
  .bubble.user{background:#eaf2fb;border:1px solid #cfe0f4;}
  .bubble.bot{background:#eafaf4;border:1px solid #c5ecdd;}
  .bubble.bot.abstain{background:#fdeee7;border:1px solid #f6d3c1;}
  .note{font-size:11.5px;font-style:italic;}
  .note.good{color:var(--green);} .note.warn{color:var(--verm);}
  .rule{height:1px;background:var(--line);margin:26px 0;border:0;}
  .seclabel{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    color:var(--muted);margin:0 0 6px;}
  /* VICC point-based oncogenicity arm */
  .card.vicc{flex:1;}
  .mhdr.vicc{color:var(--verm);}
  .crit{font-size:12.5px;line-height:1.55;margin-top:8px;}
  .crit .row{display:flex;gap:8px;align-items:baseline;margin-bottom:4px;}
  .crit .code{font-family:'Courier New',monospace;font-weight:700;font-size:11.5px;
    background:#fff;border:1px solid var(--line);border-radius:5px;padding:1px 6px;color:var(--ink);
    flex:0 0 auto;}
  .crit .pts{font-weight:700;color:var(--green);flex:0 0 auto;}
  .crit .pts.neg{color:var(--verm);}
  .crit .desc{color:#2a333d;}
  .crit .src{color:var(--muted);font-size:11px;}
  .crit .total{margin-top:8px;padding-top:7px;border-top:1px dashed var(--line);
    font-size:12.5px;font-weight:700;}
  .crit .total .arrow{color:var(--muted);font-weight:400;}
  /* faithfulness-gate audit badges */
  .gate{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
  .gatebadge{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;
    border-radius:11px;padding:3px 11px;}
  .gatebadge.ok{background:#e7f7f1;border:1px solid #b6e6d4;color:#0a7a57;}
  .gatebadge.abst{background:#fdeee7;border:1px solid #f6d3c1;color:#a8420c;}
  .gatebadge .tick{font-size:12px;}
  .pill.lonc{background:#4fae8f;} .pill.ben{background:var(--blue);} .pill.lben{background:#5b8fc0;}
  .bubble.bot ol{margin:4px 0 2px 18px;padding:0;}
  .crit .src{white-space:nowrap;}
  .gatebadge.info{background:#fff6e8;border:1px solid #f1dcb4;color:#8a5a00;}
  .inputs{font-size:10.5px;color:var(--muted);margin-top:6px;line-height:1.4;}
</style>
</head>
<body>
<div class="app">
  <h1>
    <svg viewBox="0 0 512 512" role="img" aria-label="VeriVar icon" xmlns="http://www.w3.org/2000/svg">
      <!-- VeriVar master colour icon (v3) — embedded from docs/branding/verivar_icon.svg
           so this figure matches the logo applied in the live dashboard. -->
      <defs>
        <linearGradient id="tealGrad" x1="322" y1="196" x2="314" y2="440" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#3DD6C0"/><stop offset="100%" stop-color="#1E9485"/>
        </linearGradient>
        <linearGradient id="gemGrad" x1="268" y1="318" x2="268" y2="382" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#4ECFC0"/><stop offset="60%" stop-color="#2EB8A6"/><stop offset="100%" stop-color="#8FAEBB"/>
        </linearGradient>
        <clipPath id="darkVClip"><polygon points="56,60 150,60 214,308 268,60 362,60 214,348"/></clipPath>
      </defs>
      <g id="dark-v">
        <polygon points="56,60 150,60 214,308 268,60 362,60 214,348" fill="#1B2E5E"/>
        <line x1="58" y1="63" x2="148" y2="63" stroke="#2D4A8A" stroke-width="5" stroke-linecap="round" opacity="0.6"/>
        <line x1="270" y1="63" x2="360" y2="63" stroke="#2D4A8A" stroke-width="5" stroke-linecap="round" opacity="0.6"/>
        <line x1="150" y1="62" x2="216" y2="310" stroke="#2A4480" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
        <line x1="266" y1="62" x2="216" y2="310" stroke="#2A4480" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
        <g clip-path="url(#darkVClip)">
          <rect x="73" y="72" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.18"/>
          <rect x="91" y="72" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.14"/>
          <rect x="109" y="72" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.10"/>
          <rect x="78" y="91" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.28"/>
          <rect x="96" y="91" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.34"/>
          <rect x="114" y="91" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.22"/>
          <rect x="83" y="110" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.48"/>
          <rect x="101" y="110" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.42"/>
          <rect x="119" y="110" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.36"/>
          <rect x="88" y="129" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.62"/>
          <rect x="106" y="129" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.68"/>
          <rect x="124" y="129" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.55"/>
          <rect x="93" y="148" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.82"/>
          <rect x="111" y="148" width="10" height="10" rx="1.5" fill="#C8D6E0" opacity="0.76"/>
          <rect x="129" y="148" width="10" height="10" rx="1.5" fill="#5ED8CA" opacity="0.70"/>
        </g>
      </g>
      <g id="teal-v">
        <polygon points="186,444 242,444 322,234 402,444 458,444 322,192" fill="url(#tealGrad)"/>
        <line x1="242" y1="442" x2="322" y2="236" stroke="#5ED8CA" stroke-width="4" stroke-linecap="round" opacity="0.55"/>
        <line x1="402" y1="442" x2="322" y2="236" stroke="#5ED8CA" stroke-width="4" stroke-linecap="round" opacity="0.55"/>
        <polygon points="322,196 314,218 330,218" fill="#FFFFFF" opacity="0.30"/>
      </g>
      <g id="gem">
        <ellipse cx="268" cy="370" rx="32" ry="8" fill="#0C1F3F" opacity="0.25"/>
        <polygon points="298,350 283,376 253,376 238,350 253,324 283,324" fill="url(#gemGrad)" stroke="#1B2E5E" stroke-width="2"/>
        <polygon points="253,324 283,324 276.5,335.5 259.5,335.5" fill="#FFFFFF" opacity="0.40"/>
        <polygon points="238,350 253,324 259.5,335.5 251,350" fill="#FFFFFF" opacity="0.15"/>
        <polygon points="298,350 283,324 276.5,335.5 285,350" fill="#0C1F3F" opacity="0.20"/>
        <polygon points="238,350 253,376 259.5,364.5 251,350" fill="#0C1F3F" opacity="0.12"/>
        <polygon points="285,350 276.5,364.7 259.5,364.7 251,350 259.5,335.3 276.5,335.3" fill="none" stroke="#FFFFFF" stroke-width="1.2" opacity="0.50"/>
        <text x="268" y="356" font-family="'Courier New', Courier, monospace" font-size="15" font-weight="700"
              fill="#FFFFFF" text-anchor="middle" dominant-baseline="middle" letter-spacing="-0.5" opacity="0.92">&lt;/&gt;</text>
      </g>
    </svg>
    <span class="wordmark"><span class="veri">Veri</span><span class="var">Var</span></span>
  </h1>
  <div class="sub">Faithful, citation-grounded somatic variant interpretation · Model: gpt-4o-mini · research/education only; not for clinical use</div>
  <div class="tabs">
    <div class="tab">Overview</div>
    <div class="tab">Variant explorer</div>
    <div class="tab active">Variant detail</div>
  </div>
{% for ex in examples %}
  {% if not loop.first %}<hr class="rule">{% endif %}
  <div class="seclabel">{{ ex.label }}</div>
  <div class="vhead"><span class="name">{{ ex.name }}</span><span class="ctx">· {{ ex.ctx }}</span></div>
  <div class="badges">{% for b in ex.badges %}<span class="badge">{{ b }}</span>{% endfor %}</div>
  <div class="cols">
    {% for m in ex.modes %}
    <div class="card">
      <div class="mhdr {{ m.cls }}">{{ m.header }}</div>
      <span class="pill {{ m.pill }}">{{ m.call }}</span><span class="tier">{{ m.tier }}</span>
      <div class="rat">{{ m.rationale_html|safe }}</div>
      <div class="cites">cites: {{ m.cites_html|safe }}</div>
    </div>
    {% endfor %}
    <div class="card vicc">
      <div class="mhdr vicc">VICC oncogenicity · point-based rule arm</div>
      <span class="pill {{ ex.vicc.pill }}">{{ ex.vicc.call }}</span><span class="tier">{{ ex.vicc.points }} points · {{ ex.vicc.band }}</span>
      <div class="crit">
        {% for r in ex.vicc.rows %}
        <div class="row"><span class="code">{{ r.code }}</span><span class="pts{% if r.points < 0 %} neg{% endif %}">{{ '%+d'|format(r.points) }}</span>
          <span class="desc">{{ r.statement }} <span class="src">({{ r.source }})</span></span></div>
        {% else %}
        <div class="row"><span class="desc">no criterion fired</span></div>
        {% endfor %}
        <div class="total">Σ = {{ ex.vicc.points }} → {{ ex.vicc.call }} <span class="arrow">(SOP-strict engine output)</span></div>
        <div class="inputs">{{ ex.vicc.inputs }}</div>
      </div>
    </div>
  </div>

  <div class="gate">
    {% for g in ex.gate %}<span class="gatebadge {{ g.cls }}"><span class="tick">{{ g.tick }}</span>{{ g.text }}</span>
    {% endfor %}
  </div>

  {% if ex.evidence %}
  <div class="sect">
    <div class="bar">📚 Evidence · drugs · trials  (showing {{ ex.evidence|length }} of {{ ex.n_evidence }})</div>
    <div class="body">
      {% for e in ex.evidence %}<div class="ev"><a href="#">{{ e.id }}</a> <span class="dis">[{{ e.disease }}]</span>: {{ e.statement }}</div>
      {% endfor %}
      <div class="ext">🔗 External: <a href="#">OncoKB</a> · <a href="#">ClinVar</a> ·
        <a href="#">cBioPortal</a> · <a href="#">COSMIC</a> · <a href="#">DGIdb</a>{% if ex.trial %} ·
        trials <a href="#">{{ ex.trial }}</a>{% endif %}</div>
    </div>
  </div>
  {% endif %}

  <div class="chat">
    <div class="q">💬 Ask about <b>{{ ex.chat.variant }}</b> · {{ ex.ctx }}</div>
    <div class="bubble user">{{ ex.chat.question }}</div>
    <div class="bubble bot{% if ex.chat.abstain %} abstain{% endif %}">{{ ex.chat.answer_html|safe }}</div>
    <div class="note {{ 'warn' if ex.chat.abstain else 'good' }}">{{ ex.chat.note }}</div>
  </div>
{% endfor %}
</div>
</body>
</html>
